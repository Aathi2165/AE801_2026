    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "plt.rcParams.update({\"figure.dpi\": 110, \"axes.grid\": True, \"grid.alpha\": 0.3})\n",
    "\n",
    "omega_p = 1.0\n",
    "x0, v0, T = 0.5, 0.0, 20.0\n",
    "\n",
    "def x_exact(t): return 0.5 * np.cos(omega_p * t)\n",
    "def v_exact(t): return -0.5 * np.sin(omega_p * t)"
   ]
