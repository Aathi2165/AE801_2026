    "#Defining cubic spline function\n",
    "def cubicspline(x,y,xx):\n",
    "    n=len(x)\n",
    "    h=np.diff(x)\n",
    "    A=np.zeros((n,n))\n",
    "    b=np.zeros(n)\n",
    "\n",
    "    A[0,0]=1\n",
    "    A[-1,-1]=1\n",
    "\n",
    "    for i in range (1,n-1):\n",
    "        A[i,i-1]=h[i-1]\n",
    "        A[i,i]= 2*(h[i-1]+h[i])\n",
    "        A[i,i+1]= h[i]\n",
    "\n",
    "        b[i]=6*((y[i+1]-y[i])/h[i] - (y[i]-y[i-1])/h[i-1])\n",
    "\n",
    "    M=np.linalg.solve(A,b)\n",
    "    yy=np.zeros_like(xx)\n",
    "\n",
    "    for k, xval in enumerate(xx):\n",
    "        for i in range(n-1):\n",
    "            if x[i] <= xval <= x[i+1]:\n",
    "                hi = x[i+1]-x[i]\n",
    "\n",
    "                yy[k] = (M[i]*(x[i+1]-xval)**3/(6*hi)+M[i+1]*(xval-x[i]**3/(6*hi)+(y[i]-M[i]*hi**2/6)*(x[i+1]-xval)/hi+(y[i+1]-M[i-1]*hi**2/6)*(xval-x[i])/hi))\n",
    "\n",
    "                break\n",
    "    return yy\n"
   ]
