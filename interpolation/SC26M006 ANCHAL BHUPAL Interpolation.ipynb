    "xl_data = xl[idx_l]\n",
    "yl_data = yl[idx_l]\n",
    "\n",
    "yu_uniform = np.array([Lagrng(xu_data, yu_data, N_plot, xx) for xx in x_fine])\n",
    "yl_uniform = np.array([Lagrng(xl_data, yl_data, N_plot, xx) for xx in x_fine])\n",
    "\n",
    "beta= np.linspace(0, np.pi, N_plot)\n",
    "x_cos = 0.5*(1-np.cos(beta))\n",
